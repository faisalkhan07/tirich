# Supabase Postgres
# Pooled connection (runtime, Vercel): Project Settings > Database > Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (migrations only): port 5432
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Storage (product images) - used from Phase 4
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="products"

# Admin session (generate with: openssl rand -base64 32)
SESSION_SECRET=""

# Seed: first admin user
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-now"

# Email Notifications (Gmail SMTP or Resend)
SMTP_USER="sultanbaghe@gmail.com"
SMTP_PASS=""
SMTP_FROM="Tirich Orders <sultanbaghe@gmail.com>"
RESEND_API_KEY=""
ZAPIER_WEBHOOK_URL=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
